#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Xi–χ field viewer (robust)
- Auto-discovers VTU time series in ./data or ./XiChiFieldSimulation_fixed_mkii/output
- Loads odd VTUs (Vertex/triangle/line) via meshio fallback
- Guarantees a scalar 'Xi' for coloring (derived from geometry if missing)
- Start/Stop GUI using PyVistaQt
"""

import sys
import glob
from pathlib import Path

import numpy as np
import pyvista as pv

try:
    from pyvistaqt import BackgroundPlotter
except Exception:
    pass
from PyQt5 import QtWidgets, QtCore
try:
    from ._make_controls import build_controls, dock_controls
except Exception:
    from _make_controls import build_controls, dock_controls
from PyQt5 import QtWidgets, QtCore
try:
    from ._make_controls import build_controls, dock_controls
except Exception:
    from _make_controls import build_controls, dock_controls
try:
    from ._make_controls import build_controls, dock_controls
except Exception:
    from _make_controls import build_controls, dock_controls
except Exception as e:
    print("pyvistaqt not available:", e)
    print("Install with: python3 -m pip install --user pyvistaqt")
    sys.exit(1)


# =========================
# Robust VTU loader
# =========================
def _add_Xi_if_missing(mesh: pv.DataSet) -> pv.DataSet:
    """Ensure a scalar named 'Xi' exists to color by."""
    if "Xi" in mesh.point_data or "Xi" in mesh.cell_data:
        return mesh

    P = getattr(mesh, "points", None)
    if P is None or P.size == 0:
        mesh.point_data["Xi"] = np.arange(getattr(mesh, "n_points", 0), dtype=float)
        return mesh

    # If 3D points: use elevation (Z). If 2D: use XY radius.
    if P.shape[1] >= 3:
        mesh.point_data["Xi"] = P[:, 2]
    else:
        mesh.point_data["Xi"] = np.linalg.norm(P[:, :2], axis=1)
    return mesh


def load_any_vtu(path: str | Path) -> pv.DataSet:
    """Read a VTU robustly. If the standard reader fails (e.g., 'Vertex' cells), use meshio."""
    p = str(path)
    try:
        m = pv.read(p)  # normal path (handles standard VTK/VTU)
        return _add_Xi_if_missing(m)
    except Exception:
        # Fallback path: use meshio for odd/unsupported cell types
        import meshio

        msh = meshio.read(p)
        pts = msh.points.astype(float, copy=False)

        kinds = [blk.type.lower() for blk in msh.cells]
        # Build a PolyData for points/lines/triangles; default to points
        if not kinds or "vertex" in kinds:
            mesh = pv.PolyData(pts)
        elif "triangle" in kinds:
            tri = msh.cells[kinds.index("triangle")].data
            faces = np.hstack([np.full((tri.shape[0], 1), 3), tri]).ravel()
            mesh = pv.PolyData(pts, faces=faces)
        elif "line" in kinds:
            seg = msh.cells[kinds.index("line")].data
            lines = np.hstack([np.full((seg.shape[0], 1), 2), seg]).ravel()
            mesh = pv.PolyData(pts, lines=lines)
        else:
            # Unknown topology → show as points (safe fallback)
            mesh = pv.PolyData(pts)

        # Carry over a 1-component point array if present, else synthesize
        xi = None
        for name, arr in msh.point_data.items():
            a = np.asarray(arr)
            if a.ndim == 1 or (a.ndim == 2 and a.shape[1] == 1):
                xi = a.ravel()
                break
        if xi is None:
            xi = (pts[:, 2] if pts.shape[1] >= 3 else np.linalg.norm(pts[:, :2], axis=1))

        mesh.point_data["Xi"] = xi
        return mesh


# =========================
# File discovery
# =========================
BASE = Path(__file__).resolve().parent

def discover_series() -> list[Path]:
    """Find VTU frames in preferred locations, sorted."""
    candidates = []
    # Preferred: ./data/xi_field*.vtu
    candidates.extend(sorted((BASE / "data").glob("xi_field*.vtu")))
    # Fallback: ./XiChiFieldSimulation_fixed_mkii/output/fields_t*.vtu
    candidates.extend(sorted((BASE / "XiChiFieldSimulation_fixed_mkii" / "output").glob("fields_t*.vtu")))
    # Remove dupes while preserving order
    seen, uniq = set(), []
    for f in candidates:
        if f not in seen:
            uniq.append(f)
            seen.add(f)
    return uniq


# =========================
# Viewer / Controller
# =========================
class Viewer:
    def __init__(self, files: list[Path], interval_ms: int = 250):
        if not files:
            raise FileNotFoundError("No VTU files found in ./data or ./XiChiFieldSimulation_fixed_mkii/output")

        self.files = files
        self.idx = 0
        self.timer = None
        self.interval_ms = interval_ms

        self.plotter = BackgroundPlotter(title="PyVista")
        self.plotter.add_text("Ξ-χ Field Simulation", position="upper_left", font_size=10)
        self.plotter.show_axes()

        # UI panel
        self._make_controls()

        # initial frame
        self.mesh_actor = None
        self._show_frame(0)
    def _make_controls(self):
        # Build a Qt controls widget and dock it; keep handles.
        try:
            w = build_controls(self)
        except Exception:
            # Fallback: minimal empty panel if builder is missing
            w = QtWidgets.QWidget()
        self.controls_widget = w
        self.dock_controls = dock_controls(self.plotter, w, area='right', name='Controls')
        return w



    def _show_frame(self, i: int):
        self.idx = i % len(self.files)
        f = self.files[self.idx]

        try:
            mesh = load_any_vtu(f)
        except Exception as e:
            # If a frame is unreadable, log and skip to the next
            print(f"[warn] failed to load {f}: {e}")
            self.idx = (self.idx + 1) % len(self.files)
            return

        # first time: add; later: update
        if self.mesh_actor is None:
            self.mesh_actor = self.plotter.add_mesh(
                mesh,
                scalars=("Xi" if "Xi" in mesh.point_data else None),
                show_edges=False,
                cmap="viridis",
                clim="auto",
            )
            self.plotter.add_scalar_bar(title="Xi")
        else:
            self.mesh_actor.mapper.SetInputData(mesh)  # update data
            if "Xi" in mesh.point_data:
                self.mesh_actor.mapper.SetArrayName("Xi")
            self.plotter.render()

        # window title with frame info
        self.plotter.app_window.setWindowTitle(f"PyVista – {f.name} ({self.idx+1}/{len(self.files)})")

    # --- playback controls ---
    def _tick(self):
        self._show_frame(self.idx + 1)

    def start(self):
        from qtpy.QtCore import QTimer
        if self.timer is None:
            self.timer = QTimer()
            self.timer.timeout.connect(self._tick)
        if not self.timer.isActive():
            self.timer.start(self.interval_ms)

    def stop(self):
        if self.timer and self.timer.isActive():
            self.timer.stop()


def main():
    files = discover_series()
    v = Viewer(files, interval_ms=250)
    # keep the Qt app running
    if pv.rcParams.get("interactive", True):
        pv.rcParams["interactive"] = True
    v.plotter.app.exec_()


if __name__ == "__main__":
    main()
