diff --git a/src/sinusoidal_modulation.cc b/src/sinusoidal_modulation.cc
index 7f8e9d0..0a1b2c3 100644
--- a/src/sinusoidal_modulation.cc
+++ b/src/sinusoidal_modulation.cc
@@ -1,8 +1,9 @@
 #include "sinusoidal_modulation.h"
 #include <cmath>
 
-template <int dim>
-void apply_sinusoidal_modulation(DoFHandler<dim> &dof_handler,
+template <int dim>
+void apply_sinusoidal_modulation(DoFHandler<dim> & /*dof_handler*/,  // unused
                                  Vector<double> &data,
                                   double amplitude)
 {
+  (void)amplitude; // suppress “unused parameter” if amplitude isn't used in your inner loop
   const double two_pi = 2.0 * numbers::PI;
   for (unsigned int i = 0; i < data.size(); ++i)
     data[i] += amplitude * std::sin(two_pi * i / data.size());
